---
/**
 * The under-hero proof: a real `taujs_who_calls_service` answer for the
 * catalog service, read from `src/data/who-calls-catalog.json`. Rows are
 * never written here; the JSON is captured from a real boot.
 *
 * `edges` (declared / observed) and `hostObserved` are rendered as separate
 * groups because the tool reports them separately, so a host-observed row is
 * never mistaken for a declared edge.
 */
import answer from "../data/who-calls-catalog.json";

type Edge = { source: string; path: string; method: string };
type Group = { label: string; rows: Edge[]; empty: string; host: boolean };

const service: string = answer.service;
const note: string | undefined = answer.note;
const groups: Group[] = [
  { label: "edges", rows: answer.edges ?? [], empty: "no rows", host: false },
  { label: "hostObserved", rows: answer.hostObserved ?? [], empty: "no observation", host: true },
];
---

<figure class="ev-card">
  <figcaption class="ev-card__q">
    <span class="ev-card__prompt">Interrogate</span>
    What depends on the catalog service?
  </figcaption>

  <div class="ev-card__tool">
    <code>taujs_who_calls_service</code>
    <code class="ev-card__arg">service: "{service}"</code>
  </div>

  {
    groups.map((g) => (
      <section class:list={["ev-card__group", { "ev-card__group--host": g.host }]} aria-label={g.label}>
        <h3 class="ev-card__label">{g.label}</h3>
        {g.rows.length === 0 ? (
          <p class="ev-card__empty">{g.empty}</p>
        ) : (
          <>
            <div class="ev-card__head" aria-hidden="true">
              <span>route</span>
              <span>method</span>
              <span class="ev-card__source">source</span>
            </div>
            <ul class="ev-card__rows">
              {g.rows.map((e) => (
                <li class="ev-card__row">
                  <span class="ev-card__path">
                    <span class="sr-only">route </span>
                    <code>{e.path}</code>
                  </span>
                  <span class="ev-card__method">
                    <span class="sr-only">method </span>
                    <code>{e.method}</code>
                  </span>
                  <span class="ev-card__source">
                    <span class="sr-only">source </span>
                    <span class={`ev-card__badge ev-card__badge--${e.source}`}>{e.source}</span>
                  </span>
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    ))
  }

  <p class="ev-card__key">
    <em>Declared</em> means intended. <em>Observed</em> means exercised. Missing means not seen yet
    - not "safe".
  </p>

  {
    note && (
      <details class="ev-card__note">
        <summary>What the tool says about these labels</summary>
        <p>{note}</p>
      </details>
    )
  }
</figure>

<style>
  .ev-card {
    --ev-mono: var(--sl-font-system-mono, ui-monospace, monospace);
    --ev-line: var(--sl-color-gray-5);
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--ev-line);
    border-radius: 0.5rem;
    background: var(--sl-color-black);
    color: var(--sl-color-text);
    font-size: 0.9rem;
    line-height: 1.45;
  }
  :global([data-theme="light"]) .ev-card {
    --ev-line: var(--sl-color-gray-4);
    background: var(--sl-color-gray-7);
  }

  .ev-card__q {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .ev-card__prompt {
    display: inline-block;
    margin-right: 0.5rem;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--sl-color-accent-high);
    border-radius: 0.25rem;
    font-family: var(--ev-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sl-color-accent-high);
    vertical-align: middle;
  }

  .ev-card__tool {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-bottom: 1rem;
    font-family: var(--ev-mono);
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }
  .ev-card__tool code {
    background: none;
    padding: 0;
    color: inherit;
  }
  .ev-card__tool code:first-child {
    color: var(--sl-color-accent-high);
  }

  .ev-card__group {
    padding: 0.6rem 0 0.6rem 0.75rem;
    border-left: 2px solid var(--ev-line);
  }
  .ev-card__group + .ev-card__group {
    margin-top: 0.75rem;
  }
  .ev-card__group--host {
    border-left-style: dashed;
  }
  .ev-card__label {
    margin: 0 0 0.35rem;
    font-family: var(--ev-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--sl-color-gray-3);
  }

  /* Narrow (default): each row stacks path → method → source. Identifiers are
     never broken mid-token; `overflow-wrap: anywhere` is the fallback only when
     a single token is wider than the card. */
  .ev-card__head {
    display: none;
  }
  .ev-card__rows {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--ev-mono);
    font-size: 0.85rem;
  }
  .ev-card__row {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    min-width: 0;
  }
  .ev-card__row > span {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .ev-card__rows code {
    background: none;
    padding: 0;
    color: var(--sl-color-white);
  }
  .ev-card__method code {
    color: var(--sl-color-gray-2);
  }

  /* Wide: one grid row per edge, aligned under a visible header. */
  @media (min-width: 40rem) {
    .ev-card__head,
    .ev-card__row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      column-gap: 0.75rem;
      align-items: baseline;
    }
    .ev-card__head {
      margin-bottom: 0.2rem;
      padding-bottom: 0.2rem;
      border-bottom: 1px solid var(--ev-line);
      font-family: var(--ev-mono);
      font-size: 0.65rem;
      letter-spacing: 0.04em;
      color: var(--sl-color-gray-3);
    }
    .ev-card__rows {
      gap: 0.3rem;
    }
    .ev-card__source {
      text-align: right;
      white-space: nowrap;
    }
  }
  .ev-card__empty {
    margin: 0;
    font-family: var(--ev-mono);
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }

  .ev-card__badge {
    display: inline-block;
    padding: 0.05rem 0.5rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--sl-color-gray-3);
  }
  .ev-card__badge--declared {
    color: var(--sl-color-accent-high);
  }
  .ev-card__badge--observed {
    color: var(--sl-color-green-high, var(--sl-color-text-accent));
  }
  .ev-card__badge--hostObserved {
    color: var(--sl-color-orange-high, var(--sl-color-gray-2));
    border-style: dashed;
  }

  .ev-card__key {
    margin: 1rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--ev-line);
    font-size: 0.875rem;
    color: var(--sl-color-gray-2);
  }
  .ev-card__key em {
    font-style: normal;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .ev-card__note {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }
  .ev-card__note summary {
    cursor: pointer;
    color: var(--sl-color-gray-2);
  }
  .ev-card__note summary:hover {
    color: var(--sl-color-white);
  }
  .ev-card__note p {
    margin: 0.5rem 0 0;
  }
</style>
